// CI/CD of the RAG data pipeline (Airflow DAG rag_ingest): unit tests of the steps -> the DAG imports in the Airflow
// image -> build + push the ml image the steps run in, ghcr.io/cvinhnguyen/fraud-ml-train:<commit> -> release it
// (Airflow Variable rag_image) -> run the DAG -> its
// checks (row count, unique ids, text, embedding size, all documents, online = offline) must pass. Runs when the
// steps, the DAG, the documents or the image changed (Jenkins polls main), or by hand. Needs Airflow up (profile
// orch); Jenkins only holds the Airflow admin credential, not Airflow's own secrets. If the run or its checks fail,
// post sets rag_image back to the image released before.
pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    AIRFLOW = 'http://airflow-webserver:8080/api/v1'
    DAG = 'rag_ingest'
    IMAGE = 'ghcr.io/cvinhnguyen/fraud-ml-train'   // the same package the training pipeline releases
  }
  stages {
    stage('RAG pipeline') {
      when {
        beforeAgent true
        anyOf {
          changeset 'ml/jobs/rag_ingest.py'; changeset 'ml/jobs/tests/**'; changeset 'ml/feature_repo_kb/**'
          changeset 'pipelines/airflow/dags/rag_ingest.py'; changeset 'generator/knowledge/**'; changeset 'ml/Dockerfile*'
          triggeredBy 'UserIdCause'
        }
      }
      stages {
        stage('Version') {
          steps {
            script { env.TAG = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim() }
            echo "image ${IMAGE}:${TAG}"
          }
        }
        stage('Unit tests') {
          steps {
            sh 'docker build -f ml/Dockerfile --target test -t fraud/ml-train:test-$TAG .'
            sh 'docker run --rm fraud/ml-train:test-$TAG python3 -m pytest -q tests/test_rag_ingest.py'
          }
        }
        stage('DAG check') {
          // the DAG must import in the Airflow image (operators, provider, lineage entities) and have 5 tasks
          steps {
            sh '''tar -C pipelines/airflow/dags -c common.py rag_ingest.py | docker run -i --rm --entrypoint bash fraud/airflow:2.10.5 -c \
                  'mkdir -p /tmp/d && tar -x -C /tmp/d && cd /tmp/d && python -c "import rag_ingest as m; t = sorted(m.dag.task_ids); print(t); assert len(t) == 5"' '''
          }
        }
        stage('Build + push image') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'ghcr', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_PW')]) {
              sh 'echo "$GHCR_PW" | docker login ghcr.io -u "$GHCR_USER" --password-stdin'
              sh '''docker build -f ml/Dockerfile --label org.opencontainers.image.revision=$(git rev-parse HEAD) -t $IMAGE:$TAG . && docker push $IMAGE:$TAG'''
            }
          }
        }
        stage('Release + run') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'airflow-admin', usernameVariable: 'AF_USER', passwordVariable: 'AF_PW')]) {
              script {   // the image released before, for the rollback in post (the DAG's default when none was)
                env.PREV_IMAGE = sh(returnStdout: true, script: '''
                  v=$(printf 'user = "%s:%s"\n' "$AF_USER" "$AF_PW" | curl -fsS -K - "$AIRFLOW/variables/rag_image" 2>/dev/null | jq -r .value)
                  echo "${v:-fraud/ml-train:latest}"
                ''').trim()
              }
              sh '''
                api() { printf 'user = "%s:%s"\n' "$AF_USER" "$AF_PW" | curl -fsS -K - -H 'Content-Type: application/json' "$@"; }
                api "$AIRFLOW/health" >/dev/null || { echo "Airflow is not up (compose profile orch)" >&2; exit 1; }
                api -X POST "$AIRFLOW/variables" -d "{\\"key\\": \\"rag_image\\", \\"value\\": \\"$IMAGE:$TAG\\"}" >/dev/null \
                  || api -X PATCH "$AIRFLOW/variables/rag_image" -d "{\\"key\\": \\"rag_image\\", \\"value\\": \\"$IMAGE:$TAG\\"}" >/dev/null
                echo "released: rag_image = $IMAGE:$TAG (previous $PREV_IMAGE)"
              '''
              script { env.RELEASED = 'true' }   // from here on a failure sets rag_image back (post)
              sh '''
                api() { printf 'user = "%s:%s"\n' "$AF_USER" "$AF_PW" | curl -fsS -K - -H 'Content-Type: application/json' "$@"; }
                api -X PATCH "$AIRFLOW/dags/$DAG" -d '{"is_paused": false}' >/dev/null
                run="ci-$TAG-$(date +%s)"
                api -X POST "$AIRFLOW/dags/$DAG/dagRuns" -d "{\\"dag_run_id\\": \\"$run\\", \\"note\\": \\"Jenkins $BUILD_TAG\\"}" >/dev/null
                echo "$run" > run_id
                while :; do
                  state=$(api "$AIRFLOW/dags/$DAG/dagRuns/$run" | jq -r .state)
                  case "$state" in success|failed) break;; esac
                  sleep 15
                done
                api "$AIRFLOW/dags/$DAG/dagRuns/$run/taskInstances" | jq -r '.task_instances[] | "\\(.task_id) \\(.state) \\(.duration // 0 | floor) s"' | sort
                echo "dag run $run: $state"
                [ "$state" = success ]
              '''
            }
          }
        }
        stage('Validation results') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'airflow-admin', usernameVariable: 'AF_USER', passwordVariable: 'AF_PW')]) {
              sh '''
                run=$(cat run_id)
                # the checks the step printed (the run already failed in the previous stage if one of them failed)
                printf 'user = "%s:%s"\n' "$AF_USER" "$AF_PW" | curl -fsS -K - -H 'Accept: text/plain' \
                  "$AIRFLOW/dags/$DAG/dagRuns/$run/taskInstances/validate_rag.run_checks/logs/1?full_content=true" \
                  | grep -E -o "(ok  |FAIL) expect_.*" || true
              '''
            }
          }
        }
      }
    }
  }
  post {
    failure {
      // a release whose run or checks failed: the DAG goes back to the image released before
      script {
        if (env.RELEASED == 'true') {
          withCredentials([usernamePassword(credentialsId: 'airflow-admin', usernameVariable: 'AF_USER', passwordVariable: 'AF_PW')]) {
            sh '''printf 'user = "%s:%s"\n' "$AF_USER" "$AF_PW" | curl -fsS -K - -H 'Content-Type: application/json' -X PATCH \
                    "$AIRFLOW/variables/rag_image" -d "{\\"key\\": \\"rag_image\\", \\"value\\": \\"$PREV_IMAGE\\"}" >/dev/null'''
          }
          echo "rag_image set back to ${env.PREV_IMAGE}"
        }
      }
    }
    always { sh 'docker image rm fraud/ml-train:test-$TAG >/dev/null 2>&1 || true; docker logout ghcr.io >/dev/null 2>&1 || true' }
  }
}
