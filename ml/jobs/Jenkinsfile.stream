// CI/CD of the stream feature jobs (push-online -> Redis, push-offline -> Delta): unit tests in the ml image's test
// stage -> build + push ghcr.io/cvinhnguyen/fraud-ml-train:<commit> -> recreate both compose services on that tag ->
// smoke test one message end to end. Runs when the jobs, the ML library, the Feast repo or the image changed (Jenkins
// polls main), or by hand. The running containers show the release: their image is the commit's tag. If the smoke
// test fails after the deploy, post recreates both services on the image they ran before.
pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    COMPOSE = 'docker compose -p fraud -f infra/docker-compose.yaml'
    IMAGE = 'ghcr.io/cvinhnguyen/fraud-ml-train'   // the same package the training pipeline releases
  }
  stages {
    stage('Stream feature jobs') {
      when {
        beforeAgent true
        anyOf {
          changeset 'ml/jobs/**'; changeset 'ml/fraud_ml/**'; changeset 'ml/feature_repo/**'; changeset 'ml/Dockerfile*'
          triggeredBy 'UserIdCause'
        }
      }
      stages {
        stage('Version') {
          steps {
            script { env.TAG = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim() }
            echo "image ${IMAGE}:${TAG}"
          }
        }
        stage('Unit tests') {
          steps {
            sh 'docker build -f ml/Dockerfile --target test -t fraud/ml-train:test-$TAG .'
            sh 'docker run --rm fraud/ml-train:test-$TAG'
          }
        }
        stage('Build + push image') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'ghcr', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_PW')]) {
              sh 'echo "$GHCR_PW" | docker login ghcr.io -u "$GHCR_USER" --password-stdin'
              sh '''docker build -f ml/Dockerfile --label org.opencontainers.image.revision=$(git rev-parse HEAD) -t $IMAGE:$TAG . && docker push $IMAGE:$TAG'''
            }
          }
        }
        stage('Deploy') {
          // both services move to this commit's image (PUSH_JOBS_IMAGE); prev-image.txt keeps the image they ran
          // before, which post puts back on failure. Kafka is started if it is down (the jobs consume it)
          steps {
            withCredentials([string(credentialsId: 'ml-db-password', variable: 'ML_DB_PASSWORD'),
                             string(credentialsId: 'redis-password', variable: 'REDIS_PASSWORD'),
                             string(credentialsId: 's3-access-key', variable: 'S3_ACCESS_KEY'),
                             string(credentialsId: 's3-secret-key', variable: 'S3_SECRET_KEY')]) {
              sh '$COMPOSE --profile core up -d --no-deps --wait kafka'
              script { env.DEPLOYED = 'true' }   // from here on a failure puts the previous image back (post)
              sh "docker inspect push-online --format '{{.Config.Image}}' > prev-image.txt 2>/dev/null || : > prev-image.txt"
              sh 'PUSH_JOBS_IMAGE=$IMAGE:$TAG $COMPOSE --profile ml up -d --no-deps --force-recreate push-online push-offline'
              sh 'sleep 5; docker ps --filter name=push- --format "{{.Names}} {{.Image}} {{.Status}}"'
            }
          }
        }
        stage('Smoke test') {
          steps {
            withCredentials([string(credentialsId: 'ml-db-password', variable: 'ML_DB_PASSWORD'),
                             string(credentialsId: 'redis-password', variable: 'REDIS_PASSWORD'),
                             string(credentialsId: 's3-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                             string(credentialsId: 's3-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')]) {
              sh '''docker run --rm --network fraud_default -e ML_DB_PASSWORD -e REDIS_PASSWORD -e AWS_ACCESS_KEY_ID \
                      -e AWS_SECRET_ACCESS_KEY $IMAGE:$TAG python3 /opt/ml/tools/stream_smoke.py --timeout 180'''
            }
          }
        }
      }
    }
  }
  post {
    // the compose file's default image becomes the release too, so a `docker compose up` by hand keeps it
    // (docker ps then shows :latest; the commit is the image label org.opencontainers.image.revision)
    success { sh '[ -n "${TAG:-}" ] && docker image inspect $IMAGE:$TAG >/dev/null 2>&1 && docker tag $IMAGE:$TAG fraud/ml-train:latest || true' }
    always { sh 'docker image rm fraud/ml-train:test-$TAG >/dev/null 2>&1 || true; docker logout ghcr.io >/dev/null 2>&1 || true' }
    failure {
      sh 'docker logs --tail 30 push-online 2>&1 || true; docker logs --tail 30 push-offline 2>&1 || true'
      script {
        if (env.DEPLOYED == 'true') {
          withCredentials([string(credentialsId: 'ml-db-password', variable: 'ML_DB_PASSWORD'),
                           string(credentialsId: 'redis-password', variable: 'REDIS_PASSWORD'),
                           string(credentialsId: 's3-access-key', variable: 'S3_ACCESS_KEY'),
                           string(credentialsId: 's3-secret-key', variable: 'S3_SECRET_KEY')]) {
            sh '''
              [ -s prev-image.txt ] || { echo "no previous image to roll back to"; exit 0; }
              PUSH_JOBS_IMAGE=$(cat prev-image.txt) $COMPOSE --profile ml up -d --no-deps --force-recreate push-online push-offline
              echo "push-online, push-offline back on $(cat prev-image.txt)"
            '''
          }
        }
      }
    }
  }
}
